NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_RAKUTEN_APP_ID=
NEXT_PUBLIC_RAKUTEN_ACCESS_KEY=

# === Neon Migration (Phase 1: Supabase → Neon + Clerk + R2) ===
# 計画書: _bmad-output/planning-artifacts/migration-neon-clerk-r2.md v3.5

# Neon Console URL `/app/projects/<ID>` の <ID> 部分
NEON_PROJECT_ID=
# Neon Console → Account settings → API keys で発行
NEON_API_KEY=
# Neon Console → Connection Details → Pooled connection ON で表示される URL
# 例: postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL_POOLED=
# Pooled connection OFF で表示される URL (host に -pooler なし)
# 例: postgresql://neondb_owner:PASSWORD@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL_DIRECT=
# Supabase Console → Project Settings → Database → Connection string → URI (Phase 1 A-3 pg_dump のみ)
SUPABASE_DB_URL=

# Clerk (Phase 1 B-2 で発行)
# Clerk Dashboard → API Keys → "Show API Keys for Next.js"
# Development 環境では test キー (pk_test_xxx / sk_test_xxx) を使用
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook secret は Phase 5 で /api/webhooks/clerk 実装後に発行 (B-3 で skip)
CLERK_WEBHOOK_SECRET=
# Clerk Sign-in/Sign-up URL (Phase 7 cutover 準備、/clerk-sign-in / /clerk-sign-up に
# 配置した catch-all ルートを指す)。設定がない場合 Clerk のデフォルト /sign-in が使われる
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/clerk-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/clerk-sign-up
# サインイン後の遷移先 (デフォルト: /)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Cloudflare R2 (Phase 1 C-2/C-3 で発行)
# R2 Dashboard 右側「アカウント詳細」→ アカウント ID
R2_ACCOUNT_ID=
# R2 → API トークンの管理 で発行 (1 token で 3 bucket 全スコープ)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 互換 endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=
# 環境別 bucket 名 (Production: prod / Preview: preview / Development: dev)
R2_BUCKET_NAME=golf-assistant-dev
# Phase 4: object_key から `${R2_PUBLIC_BASE_URL}/${object_key}` を生成する
# 例: https://img-dev.golf-assistant.app または https://pub-xxx.r2.dev
R2_PUBLIC_BASE_URL=
